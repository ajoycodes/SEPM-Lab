            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Admin {{n}}\",\n  \"email\": \"admin{{n}}@university.edu\",\n  \"phone\": \"+8801711111111\",\n  \"username\": \"admin_{{n}}\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 Created, with a Location header. Saves the new id for the next requests."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('n', Date.now() % 1000000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
